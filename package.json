{
  "name": "policygen",
  "version": "0.1.0",
  "description": "주제+목차를 입력하면 출처 검증을 거친 정책보고서(DOCX) 초안을 생성하는 도구",
  "type": "module",
  "bin": {
    "policygen": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "docx": "^9.0.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
